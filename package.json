{
  "name": "tohuus-hub",
  "version": "0.1.0",
  "description": "Self-hosted household stock, recipes and guest bar \u2014 with Home Assistant and MCP built in.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --packages=external && esbuild scripts/restore-check.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/restore-check.mjs --packages=external",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "restore-check": "tsx scripts/restore-check.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "imapflow": "^2.4.0",
    "jose": "^6.2.12",
    "mailparser": "^3.9.38",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "sharp": "^0.35.5",
    "undici": "^7.30.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource/hedvig-letters-sans": "5.3.0",
    "@fontsource/hedvig-letters-serif": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "barcode-detector": "^3.2.2",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
