# Public URL (used in links, notifications, MCP and guest links, the iPhone app's QR code, CalDAV and calendar links).
# Use the address your phones open, e.g. https://tohuus.example.org – not localhost. The iPhone app needs https
# outside the home network.
BASE_URL=http://localhost:8080

# Port and data folder (Docker: 8080 and /data, set in the image)
# PORT=8080
# DATA_DIR=./data

# Optional but recommended: encrypt the database, photos and backups at rest.
# 32 random bytes (openssl rand -base64 32) or a long passphrase. Keep it outside the data volume – without it the
# data cannot be read. An existing unencrypted database is converted on the next start (the plain original is kept
# next to it as tohuus.db.plain-backup-<date>; delete it yourself after checking).
# DB_ENCRYPTION_KEY=

# Optional: storage limit in MB for photos, receipt files and the database (0 = unlimited)
# STORAGE_QUOTA_MB=0

# First admin account (created on first start only)
ADMIN_NAME=Alex
ADMIN_PASSWORD=change-me

# Language on first start: en | de (changeable in the app)
LANGUAGE=en
# Where the household shops on first start: DE, AT, CH, GB, IE, US, SE, DK, NO, NL (default from LANGUAGE)
# REGION=GB

# BRAND is no longer used (one look since 2026-10-11); old values are ignored.

# Fill the instance with demo data on first start (drinks menu, pantry, recipes)
SEED_DEMO=false

# Optional: AI for the assistant, voice and receipt photos. A key alone uses OpenRouter, pinned to Mistral
# (EU, no fallbacks, no data collection). Any OpenAI-compatible endpoint works via AI_BASE_URL.
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL_TEXT=mistralai/mistral-small-2603
# AI_MODEL_VISION=mistralai/mistral-small-2603
# AI_MODEL_VISION_HARD=mistralai/mistral-large-4-0
# AI_MODEL_AUDIO=mistralai/voxtral-small-24b-2507
# Other Mistral models tried when the main one is busy (comma-separated, - = none)
# AI_MODEL_FALLBACKS=

# Optional stars for households (docs/points.md). Off unless set to "on"; then a household admin decides.
# POINTS=on

# Text recognition for receipt photos without AI (tesseract is in the Docker image). 1 = off.
# OCR_DISABLED=
# TESSERACT_BIN=tesseract

# Older installs: vision model for photo imports only (used when no AI_* is set)
# VISION_BASE_URL=https://api.mistral.ai/v1
# VISION_API_KEY=
# VISION_MODEL=mistral-medium-latest

# Optional: e-mail notifications / daily digest
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="ToHuus Hub <haus@example.org>"

# Optional: fixed secret path for MCP (/mcp/<secret>). Tokens created in the app work as well.
# MCP_PATH_SECRET=

# Open Food Facts lookups (product images, barcodes). Please keep a contact in the user agent.
# OFF_USER_AGENT=ToHuusHub/0.1 (you@example.org)
TZ=Europe/Berlin

# Optional single sign-on (OpenID Connect) – seeds Settings → Members → Single sign-on on the first start.
# Redirect URI to register at the provider: <BASE_URL>/api/auth/oidc/callback  (see docs/auth.md)
# OIDC_ISSUER=https://auth.example.org/application/o/tohuus
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Sign in with Authentik
# Locked out? true = passwords for everyone, no two-step requirement (remove afterwards)
# AUTH_BREAK_GLASS=false

# Number of reverse proxies in front (for rate limiting by client IP)
# TRUST_PROXY_HOPS=1

# Optional: your own privacy policy / terms / imprint, linked in the web and iPhone app
# LEGAL_PRIVACY_URL= / LEGAL_TERMS_URL= / LEGAL_IMPRINT_URL=

# iPhone push (APNs) needs the key of the developer account that signs the app – the App Store app cannot receive
# push from a self-hosted server. Use Web Push (web app on the home screen), ntfy, Telegram or e-mail instead.
# APNS_KEY_ID= / APNS_TEAM_ID= / APNS_KEY_P8= / APNS_TOPIC= / APNS_ENV=

# ---------------------------------------------------------------- ToHuus Cloud only (see docs/cloud.md)
# MULTI_TENANT=true
# TOHUUS_MASTER_KEY=            # 32 bytes base64 – required in cloud mode, environment only
# CLOUD_SIGNUP=true
# CLOUD_NAME=ToHuus Cloud
# HOUSEHOLD_POOL_MAX=64
# HOUSEHOLD_POOL_IDLE_MIN=10
# APPLE_BUNDLE_ID=de.heidrichdigital.tohuus
# APPLE_ENVIRONMENTS=Production,Sandbox
# BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=fsn1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=tohuus
