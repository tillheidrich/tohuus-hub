# Public URL (used in links, notifications, MCP and guest links)
BASE_URL=http://localhost:8080

# First admin account (created on first start only)
ADMIN_NAME=Alex
ADMIN_PASSWORD=change-me

# Language on first start: en | de (changeable in the app)
LANGUAGE=en

# Fill the instance with demo data on first start (Fredirando bar, pantry, recipes)
SEED_DEMO=false

# Optional: vision model for photo imports (receipts, shelves, recipe cards).
# Any OpenAI-compatible endpoint works: Mistral (EU), Ollama, vLLM, OpenRouter …
# VISION_BASE_URL=https://api.mistral.ai/v1
# VISION_API_KEY=
# VISION_MODEL=mistral-medium-latest

# Optional: e-mail notifications / daily digest
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="ToHuus Hub <haus@example.org>"

# Optional: fixed secret path for MCP (/mcp/<secret>). Tokens created in the app work as well.
# MCP_PATH_SECRET=

# Open Food Facts lookups (product images, barcodes). Please keep a contact in the user agent.
# OFF_USER_AGENT=ToHuusHub/0.1 (you@example.org)
TZ=Europe/Berlin
