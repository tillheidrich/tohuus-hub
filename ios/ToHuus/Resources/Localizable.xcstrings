    "Claude, ChatGPT and co. may reach ToHuus with an access you create. This is separate from the built-in AI: ToHuus itself calls no model for it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT and co. may reach ToHuus with an access you create. This is separate from the built-in AI: ToHuus itself calls no model for it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT & Co. dürfen mit einem Zugang, den ihr anlegt, auf ToHuus zugreifen. Das ist unabhängig von der eingebauten KI: ToHuus selbst fragt dafür kein Modell."
          }
        }
      }
    },
