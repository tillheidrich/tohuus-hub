        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple lässt die App Passkeys nur für ToHuus Cloud anlegen. Für %@ legst du ihn in Safari unter Mein Konto › Passkeys an. Wischen zum Umbenennen oder Entfernen."
          }
        }
      }
    },
