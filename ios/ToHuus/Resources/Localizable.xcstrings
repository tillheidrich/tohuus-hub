    },
    "The server answered in a way the app doesn't understand yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered in a way the app doesn't understand yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat so geantwortet, dass die App es noch nicht versteht."
          }
        }
      }
    },
    "The shared list, shop mode, what ToHuus remembers from receipts and ticks, recipes, money, “Sprechen” with simple sentences, receipts read on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared list, shop mode, what ToHuus remembers from receipts and ticks, recipes, money, “Sprechen” with simple sentences, receipts read on this iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gemeinsame Liste, der Ladenmodus, was ToHuus sich aus Bons und Häkchen merkt, Rezepte, Geld, „Sprechen“ mit einfachen Sätzen, Bons auf diesem iPhone lesen."
          }
        }
      }
    },
    "The shopping list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shopping list"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einkaufsliste"
          }
        }
      }
    },
    "The text is read on this iPhone. Only the lines you choose go onto the list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is read on this iPhone. Only the lines you choose go onto the list."
          }
        },
        "de": {
