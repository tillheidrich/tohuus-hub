          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen bekommen eine Nachricht mit „Ich bring’s“ oder „Geht gerade nicht“ und einem kurzen Grund. Du siehst „Kommt gleich – Mira bringt’s“."
          }
        }
      }
    },
    "The others see what’s in your basket and can ask you for something.": {
      "extractionState": "manual",
