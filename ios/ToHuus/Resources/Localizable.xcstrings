    },
    "The older “Shopping list in Home Assistant” sync is on. It is switched off and taken over when you save here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The older “Shopping list in Home Assistant” sync is on. It is switched off and taken over when you save here."
