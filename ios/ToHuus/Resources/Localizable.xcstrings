    "Guests scan a QR code, order from your party menu and pick up at the counter. The TV shows what’s being made. It ends by itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guests scan a QR code, order from your party menu and pick up at the counter. The TV shows what’s being made. It ends by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäste scannen einen QR-Code, bestellen aus eurem Party-Menü und holen an der Theke ab. Der Fernseher zeigt, was gerade gemacht wird. Am Ende schließt alles von selbst."
          }
        }
      }
    },
    "Guests scan the QR code and order; you get a push and tap “Ready”. Stock is booked by itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guests scan the QR code and order; you get a push and tap “Ready”. Stock is booked by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäste scannen den QR-Code und bestellen; du bekommst einen Push und tippst auf „Fertig“. Der Bestand bucht sich von selbst."
          }
        }
      }
    },
