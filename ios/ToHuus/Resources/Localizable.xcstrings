          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich am Ende jedes Zeitraums automatisch, wenn du nicht mindestens 24 Stunden vorher kündigst. Der Betrag wird über deinen Apple Account abgerechnet. Verwalten und kündigen kannst du dein Abo jederzeit in den Einstellungen deines Apple Accounts."
          }
        }
      }
