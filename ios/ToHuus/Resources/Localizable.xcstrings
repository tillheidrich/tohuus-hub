        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur zu Hause“ braucht die iPhone-App oder Home Assistant, um zu wissen, wo du bist – bis dahin kommt alles."
          }
        }
      }
    },
    "“Served” automatically deducts counted items from stock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Served” automatically deducts counted items from stock."
