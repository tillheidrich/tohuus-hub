    "A kid tablet shows big pictures of what your kid may wish for. Every wish waits for a parent – approved wishes land on the order board. No points, no stars.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A kid tablet shows big pictures of what your kid may wish for. Every wish waits for a parent – approved wishes land on the order board. No points, no stars."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kinder-Tablet zeigt große Bilder von dem, was sich dein Kind wünschen darf. Jeder Wunsch wartet auf eure Antwort – erlaubte Wünsche landen bei den Bestellungen. Keine Punkte, keine Sterne."
          }
        }
      }
    },
    "A kid wishes for something": {
      "extractionState": "manual",
      "localizations": {
