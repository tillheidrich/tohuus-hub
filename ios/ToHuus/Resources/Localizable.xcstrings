          "stringUnit": {
            "state": "translated",
            "value": "The place is empty, nothing gets lost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ort ist leer, es geht nichts verloren."
          }
        }
      }
    },
    "The places inside move one level up. Nothing that is stored gets lost.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The places inside move one level up. Nothing that is stored gets lost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Orte darin rücken eine Ebene nach oben. Was dort liegt, geht nicht verloren."
          }
        }
      }
    },
    "The product, its stock and its history are removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The product, its stock and its history are removed."
