        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bons zeigen ToHuus, was ihr gekauft habt, was es gekostet hat und wie oft. Papier, Foto, PDF oder E-Bon – alles gut."
          }
        }
      }
    },
