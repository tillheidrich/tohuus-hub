        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kind wünscht sich etwas"
          }
        }
      }
    },
    "A kitchen ticket for every new sofa or guest order – only orders that come in after you switch this on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
