    "Backups: ToHuus Cloud saves your household every night, encrypted, also outside the data centre. You can download everything at any time under Plan & storage › Your data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups: ToHuus Cloud saves your household every night, encrypted, also outside the data centre. You can download everything at any time under Plan & storage › Your data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungen: Die ToHuus Cloud sichert euren Haushalt jede Nacht, verschlüsselt, auch außerhalb des Rechenzentrums. Unter Abo & Speicher › Deine Daten könnt ihr jederzeit alles herunterladen."
          }
        }
      }
    },
