    },
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus nutzt die Kamera für Barcodes, Kassenbons und den QR-Code deines eigenen Servers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus uses the camera to scan barcodes, receipts and the QR code of your own server."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus nutzt das Mikrofon, wenn du mit dem Assistenten sprichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus uses the microphone when you speak to the assistant."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du sagst, wird auf deinem iPhone in Text umgewandelt, damit der Assistent dich versteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words are turned into text on your iPhone so the assistant can understand them."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus kann Bilder in deiner Fotomediathek sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus can save images to your photo library."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn du den Hinweis im Laden einschaltest: ToHuus merkt sich, wo deine Läden sind. Die Orte bleiben auf deinem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if you switch on the hint in the shop: ToHuus saves where your shops are. The places stay on your iPhone."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn du den Hinweis im Laden einschaltest: Kommst du bei einem gespeicherten Laden an, fragt ToHuus, ob es die Liste öffnen soll. Dein Standort verlässt nie dein iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if you switch on the hint in the shop: when you arrive at a shop you saved, ToHuus asks whether to open the list. Your location never leaves your iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
}