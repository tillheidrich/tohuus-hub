{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus"
          }
        }
      }
    },
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus nutzt die Kamera für Barcodes, Kassenbons und Einkaufszettel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus uses the camera to scan barcodes, receipts and paper lists."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus nutzt das Mikrofon nur, während du mit dem Assistenten sprichst oder etwas für die Liste diktierst. Kann dein iPhone Sprache nicht selbst in Text umwandeln, geht die Aufnahme dafür an ToHuus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus uses the microphone only while you speak to the assistant or dictate for the list. If your iPhone can't turn speech into text, the recording goes to ToHuus to be turned into text."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du sagst, wird in Text umgewandelt, damit der Assistent dich versteht – wenn möglich auf deinem iPhone, sonst über die Spracherkennung von Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words are turned into text so the assistant understands you – on your iPhone where possible, otherwise by Apple's speech recognition."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus kann Bilder in deiner Fotomediathek sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus can save images to your photo library."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn du den Hinweis im Laden einschaltest: ToHuus merkt sich, wo deine Läden sind. Die Orte bleiben auf deinem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if you switch on the hint in the shop: ToHuus saves where your shops are. The places stay on your iPhone."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn du den Hinweis im Laden einschaltest: Kommst du bei einem gespeicherten Laden an, fragt ToHuus, ob es die Liste öffnen soll. Dein Standort verlässt nie dein iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if you switch on the hint in the shop: when you arrive at a shop you saved, ToHuus asks whether to open the list. Your location never leaves your iPhone."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus trägt nur dann etwas ein, wenn du auf „In den Kalender“ tippst und speicherst. Deinen Kalender liest ToHuus nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToHuus only adds an entry when you tap “Add to calendar” and save it. ToHuus does not read your calendar."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn dein ToHuus-Server bei dir zu Hause läuft: ToHuus verbindet sich mit ihm in deinem Heimnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if your ToHuus server runs at home: ToHuus connects to it in your home network."
          }
        }
      }
    }
  },
  "version": "1.0"
}
